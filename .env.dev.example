# ================================================================
# ローカル開発用 .env サンプル
# ================================================================
# 使い方:
#   1. このファイルを .env にコピー
#      cp .env.dev.example .env
#   2. Dockerミドルウェアを起動（DB / Mailpit）
#      docker compose -f docker-compose-dev.yml up -d
#   3. Spring Bootを起動
#      ./gradlew bootRun  または IDEから起動
#      （プロファイル指定不要 — devが自動適用される）
#
# メール確認:  http://localhost:8025 (Mailpit UI)
# ================================================================

# ── データベース ──
DB_HOST=localhost
DB_NAME=elms_db
DB_USER=root
DB_PASS=pass
DB_PORT=5433

# ── タイムゾーン ──
TZ=Asia/Tokyo

# ── メール（Mailpit） ──
MAIL_HOST=localhost
MAIL_PORT=1025

# ── URL ──
# メール本文のリンク（パスワードリセット等）に使うフロントエンドのURL
BASE_URL=http://localhost:3000
SERVER_HOST=localhost

# ── CORS ──
# APIへのアクセスを許可するオリジン（カンマ区切りで複数指定可）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JWT ──
# base64エンコードされた32バイト以上（開発専用の固定値。本番では必ず別値を生成すること）
# 再生成例: openssl rand -base64 32
JWT_SECRET=rvNTJEhlli5Vlfu4r2xAnD1OpdvOVRCnwarDMxCLE+U=

# ── Cookie ──
COOKIE_SECURE=false

# ── ファイルストレージ（ローカル） ──
# 画像はローカルディスクに保存される（本番はS3を使用）
UPLOAD_DIR=uploads

# ── Let's Encrypt ──
# ローカル開発では不要。本番 HTTPS セットアップ時のみ使用する。
# 値の書き方は .env.prd.example の CERTBOT_EMAIL を参照（個人メールは Git に書かない）。
# CERTBOT_EMAIL=you@example.com

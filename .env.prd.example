# ── データベース ──
DB_HOST=elms-db
DB_NAME=elms_db
DB_USER=root
DB_PASS=your_db_password
DB_PORT=5432

# ── タイムゾーン ──
TZ=Asia/Tokyo

# ── JWT ──
# base64エンコードされた32バイト以上のランダム文字列
# 生成例: openssl rand -base64 32
JWT_SECRET=your_jwt_secret

# ── メール（AWS SES SMTP） ──
MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
MAIL_PORT=587
# SES SMTP 認証情報（IAMアクセスキーとは別）
MAIL_USERNAME=your_ses_smtp_username
MAIL_PASSWORD=your_ses_smtp_password

# ── URL ──
# メール本文のリンク（パスワードリセット等）に使うフロントエンドのURL
BASE_URL=https://elms-app.com
SERVER_HOST=elms-app.com

# ── CORS ──
# APIへのアクセスを許可するオリジン（カンマ区切りで複数指定可）
# localhost を含めないこと。未設定の場合はアプリが起動しない。
CORS_ALLOWED_ORIGINS=https://elms-app.com

# ── S3 画像ストレージ ──
S3_BUCKET_NAME=everrefine-elms-uploads
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ── Cookie ──
# HTTPSに移行済みの本番環境では true
COOKIE_SECURE=true

# ── Let's Encrypt（infra/aws/scripts/setup-https.sh 用） ──
# 連絡先メール。個人の実アドレスを Git に書かないこと。
# サーバー上では環境変数 CERTBOT_EMAIL で渡すか、.env にだけ実値を書く。
CERTBOT_EMAIL=you@example.com
